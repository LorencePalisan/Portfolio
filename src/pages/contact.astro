---
import Layout from '@/layouts/Layout.astro'
import ContactHero from '@/components/contact/contact-hero/contact-hero'
import Services from '@/components/shared/services/services'

const pageTitle = 'Contact'
const pageDescription =
  'Get in touch with Lorence Palisan to talk about your web app, mobile app, or business software project.'

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Lorence Palisan',
      description: 'Freelance software developer building web and mobile apps for growing businesses.',
      inLanguage: 'en-US'
    },
    {
      '@type': 'ContactPage',
      name: pageTitle,
      description: pageDescription
    }
  ]
}
---

<Layout title={pageTitle} description={pageDescription} schema={schema}>
  <ContactHero client:load />
  <Services client:visible />
</Layout>
