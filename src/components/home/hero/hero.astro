---
import AvailabilityBadge from '@/components/shared/availability-badge'
import GreetingWord from '@/components/home/hero/greeting-word'
import HeroCta from '@/components/home/hero/hero-cta'
import IdCardLazy from '@/components/ui/id-card-lazy'

interface Props {
  showWorkLink?: boolean
}

const { showWorkLink = false } = Astro.props
---

<section class='lg:relative'>
  <div class='border-b pb-8 max-sm:pt-20 sm:py-16 lg:pt-32 lg:pb-24'>
    <div class='px-4 sm:px-6 lg:px-10.5'>
      <div class='space-y-6 lg:max-w-lg'>
        <AvailabilityBadge className='h-6.5 gap-1 rounded-full' />
        <p class='text-muted-foreground text-xl font-medium lg:text-2xl'>
          <GreetingWord client:load />I am Lorence 👋🏻
        </p>
        <h1 class='mb-2 text-4xl font-semibold tracking-tight sm:text-5xl lg:text-[56px] lg:leading-tight lg:font-bold'>
          Websites and custom software built for growing businesses.
        </h1>
        <p class='mb-8 max-w-2xl text-base'>
          I help businesses and startups build, maintain, and improve websites and web applications using WordPress,
          React, and modern cloud technologies - from initial development to long-term support.
        </p>
        <HeroCta showWorkLink={showWorkLink} />
      </div>
    </div>
  </div>

  <!-- client:visible — IdCardLazy is an SSR-safe shell; it only fetches and mounts the real
       WebGL/rapier component (~1MB) once scrolled into view, and never on mobile where
       max-lg:hidden keeps it offscreen. -->
  <IdCardLazy
    client:visible
    frontImage='/images/3d-card/profile.webp'
    className='mx-auto mt-8 aspect-4/5 w-full max-w-80 max-lg:hidden lg:absolute lg:-top-31 lg:right-0 lg:left-0 lg:z-10 lg:mt-0 lg:aspect-auto lg:h-192 lg:max-w-none'
  />
</section>
